# ==============================================================================
# PEO PLATFORM - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# 
# This file contains environment variables used by the Docker Compose setup.
# Copy this file to .env and modify the values according to your environment.
#
# IMPORTANT: 
# - Never commit .env files with production secrets to version control
# - Change all default passwords before deploying to production
# - Generate secure JWT keys for production environments
#
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION - SEPARATE INSTANCES ARCHITECTURE
# ==============================================================================
# 
# Each microservice now has its own dedicated SQL Server instance for complete isolation
#
SA_PASSWORD=Peo@2024!Strong
SQLSERVER_USER=sa

# ==============================================================================
# MESSAGE BROKER CONFIGURATION  
# ==============================================================================

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# JWT Secret Key - MUST be changed in production
# Generate a secure key using: openssl rand -base64 64
JWT_

# ==============================================================================
# DOCKER COMPOSE CONFIGURATION
# ==============================================================================

COMPOSE_PROJECT_NAME=peo-platform

# ==============================================================================
# SQL SERVER INSTANCES PORTS & CONNECTION INFO
# ==============================================================================
# 
# Each microservice has its own dedicated SQL Server instance:
#
# 🏗️  ARCHITECTURE OVERVIEW:
# • Identity Service:        localhost:1433  -> identity-sqlserver container
# • Faturamento Service:     localhost:1434  -> faturamento-sqlserver container  
# • Gestao Alunos Service:   localhost:1435  -> gestao-alunos-sqlserver container
# • Gestao Conteudo Service: localhost:1436  -> gestao-conteudo-sqlserver container
#
# 📊 CONNECTION STRINGS FOR EXTERNAL TOOLS:
# Identity:       Server=localhost,1433;Database=identity-db;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=true;
# Faturamento:    Server=localhost,1434;Database=faturamento-db;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=true;
# Gestao Alunos:  Server=localhost,1435;Database=gestao-alunos-db;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=true;
# Gestao Conteudo: Server=localhost,1436;Database=gestao-conteudo-db;User Id=sa;Password=${SA_PASSWORD};TrustServerCertificate=true;

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Uncomment for development environment
# ASPNETCORE_ENVIRONMENT=Development
# LOGGING_LEVEL=Debug

# Logging Levels (Development only)
LOG_LEVEL_DEFAULT=Debug
LOG_LEVEL_MICROSOFT=Information
LOG_LEVEL_ENTITYFRAMEWORK=Information

# CORS Settings for Development
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:7031,http://localhost:5251

# ==============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ==============================================================================
#
# Before deploying to production, ensure you:
# 
# ✅ Security:
# • Change SA_PASSWORD to a strong, unique password (min 8 chars, upper+lower+numbers+symbols)
# • Generate new JWT_KEY using: openssl rand -base64 64
# • Change RABBITMQ_USER and RABBITMQ_PASSWORD  
# • Enable HTTPS for all services
# • Review CORS_ALLOWED_ORIGINS
#
# ✅ Infrastructure:
# • Set appropriate resource limits for SQL Server containers
# • Configure backup strategies for all 4 database instances
# • Set up monitoring and alerting
# • Configure log aggregation
#
# ✅ Networking:
# • Update all URLs to production domains
# • Configure reverse proxy/load balancer
# • Set up proper DNS entries
#
# ✅ Database Architecture Benefits:
# • ✅ Complete data isolation between microservices
# • ✅ Independent scaling per service
# • ✅ Fault isolation (one DB failure doesn't affect others)
# • ✅ Technology flexibility for future migrations
# • ✅ Team autonomy and independent development cycles
# • ✅ Enhanced security boundaries
#
# ⚠️  Resource Requirements:
# • Minimum 16GB RAM recommended for full stack
# • Each SQL Server instance: ~2-4GB RAM in production
# • Plan for 4x database backup and maintenance overhead
#
# ==============================================================================